<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">26</SupportedOSPlatformVersion>
    <SingleProject>true</SingleProject>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
    <ApplicationTitle>MikroAdmin</ApplicationTitle>
    <ApplicationId>com.gb.mikroadmin</ApplicationId>
    <!-- Ejecución y depuración de Windows sin generar un paquete MSIX. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationIcon>Resources/Icons/appicon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Windows usa un icono completo; Android se compone de fondo y primer plano adaptativos. -->
    <MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'"
              Include="Resources/Icons/appicon_windows.svg" />
    <MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'"
              Include="Resources/Icons/appicon.svg"
              ForegroundFile="Resources/Icons/appiconfg.svg" />
  </ItemGroup>
  <ItemGroup>
    <!-- Iconos de la barra de navegación; Shell los referencia por el .png generado del SVG. -->
    <MauiImage Include="Resources/Images/*.svg" />
  </ItemGroup>
  <ItemGroup>
    <MauiAsset Include="Resources/Icons/favicon.ico" />
    <MauiAsset Include="Resources/Icons/appicon.ico" />
    <MauiAsset Include="Resources/Icons/StoreLogo.png" />
    <MauiAsset Include="Resources/Icons/Square44x44Logo.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="tik4net" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GB.MikroAdmin.Core\GB.MikroAdmin.Core.csproj" />
  </ItemGroup>
</Project>
