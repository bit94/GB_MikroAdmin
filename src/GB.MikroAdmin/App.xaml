<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GB.MikroAdmin.Views"
             x:Class="GB.MikroAdmin.App">
  <Application.Resources>
    <ResourceDictionary>
      <views:InvertBoolConverter x:Key="Invert" />
      <!-- Paleta: un solo acento y fondos neutros, para que el estado del voucher resalte. -->
      <Color x:Key="Primary">#2563EB</Color>
      <Color x:Key="Surface">#132033</Color>
      <Color x:Key="SurfaceAlt">#1B2B44</Color>
      <Color x:Key="Border">#2C4A6E</Color>
      <Color x:Key="TextPrimary">#F8FAFC</Color>
      <Color x:Key="TextMuted">#E2E8F0</Color>

      <!-- Semántica de estado. Verde = activo/sin usar, ámbar = en uso, rojo = agotado. -->
      <Color x:Key="StateIdle">#64748B</Color>
      <Color x:Key="StateAvailable">#22C55E</Color>
      <Color x:Key="StateInUse">#F59E0B</Color>
      <Color x:Key="StateExpired">#EF4444</Color>

      <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="14" />
      </Style>

      <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="#0B1626" />
      </Style>

      <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource StateIdle}" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAlt}" />
      </Style>

      <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAlt}" />
      </Style>

      <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Margin" Value="0,14,0,2" />
      </Style>

      <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
      </Style>

      <Style x:Key="Mono" TargetType="Label">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="16" />
      </Style>

      <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="Padding" Value="12" />
      </Style>

      <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource StateExpired}" />
        <Setter Property="TextColor" Value="White" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
