<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GB.MikroAdmin.Views"
             xmlns:vm="clr-namespace:GB.MikroAdmin.ViewModels"
             x:Class="GB.MikroAdmin.Views.TicketHistoryPage"
             x:DataType="vm:TicketHistoryViewModel"
             Title="Histórico">

  <ContentPage.Resources>
    <views:NoticeColorConverter x:Key="NoticeColor" />
  </ContentPage.Resources>

  <Grid RowDefinitions="Auto,Auto,*">
    <VerticalStackLayout Grid.Row="0" Padding="12" Spacing="8">
      <Label Text="Lotes generados" Style="{StaticResource SectionTitle}" />
      <Label Text="Cada lote conserva sus códigos aunque cierres la aplicación, para poder reimprimirlos o consultarlos."
             Style="{StaticResource Caption}" />
      <Button Text="Actualizar" Command="{Binding RefreshCommand}" Padding="14,6" HorizontalOptions="Start" />
    </VerticalStackLayout>

    <VerticalStackLayout Grid.Row="1" Margin="12,0" BindableLayout.ItemsSource="{Binding Notices}">
      <BindableLayout.ItemTemplate>
        <DataTemplate x:DataType="vm:Notice">
          <Label Text="{Binding Text}" FontSize="13"
                 TextColor="{Binding Severity, Converter={StaticResource NoticeColor}}" />
        </DataTemplate>
      </BindableLayout.ItemTemplate>
    </VerticalStackLayout>

    <CollectionView Grid.Row="2" ItemsSource="{Binding Batches}" Margin="12,4,12,12">
      <CollectionView.EmptyView>
        <Label Text="Todavía no hay lotes guardados." Style="{StaticResource Caption}" Margin="0,30" HorizontalOptions="Center" />
      </CollectionView.EmptyView>
      <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="vm:TicketBatchRow">
          <Border Style="{StaticResource Card}" Margin="0,0,0,6">
            <VerticalStackLayout Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding Title}" FontAttributes="Bold" />
                <Label Grid.Column="1" Text="{Binding PrintedSummary}" Style="{StaticResource Caption}"
                       VerticalOptions="Center" />
              </Grid>
              <Label Text="{Binding Codes}" Style="{StaticResource Mono}" FontSize="13" />
              <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="8">
                <Button Text="CSV" Padding="8,4" FontSize="13"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TicketHistoryViewModel}}, Path=ExportBatchCommand, x:DataType=vm:TicketHistoryViewModel}"
                        CommandParameter="{Binding .}" />
                <Button Grid.Column="1" Text="Reimprimir" Padding="8,4" FontSize="13"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TicketHistoryViewModel}}, Path=PrintBatchCommand, x:DataType=vm:TicketHistoryViewModel}"
                        CommandParameter="{Binding .}" />
                <Button Grid.Column="2" Text="Térmico" Padding="8,4" FontSize="13"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TicketHistoryViewModel}}, Path=ThermalBatchCommand, x:DataType=vm:TicketHistoryViewModel}"
                        CommandParameter="{Binding .}" />
                <Button Grid.Column="3" Text="Quitar" Padding="8,4" FontSize="13" Style="{StaticResource DangerButton}"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TicketHistoryViewModel}}, Path=DeleteBatchCommand, x:DataType=vm:TicketHistoryViewModel}"
                        CommandParameter="{Binding .}" />
              </Grid>
            </VerticalStackLayout>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
  </Grid>
</ContentPage>
