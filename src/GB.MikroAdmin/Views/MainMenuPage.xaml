<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GB.MikroAdmin.Views.MainMenuPage"
             Title="Inicio">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="MikroAdmin" FontAttributes="Bold" FontSize="30" />
            <Label Text="Selecciona un módulo para administrar el router." TextColor="Gray" />

            <Button Text="Interfaces" Command="{Binding GoToInterfacesCommand}" HeightRequest="64" />
            <Button Text="Usuarios Hotspot" Command="{Binding GoToUsersCommand}" HeightRequest="64" />
            <Button Text="Perfiles y ancho de banda" Command="{Binding GoToProfilesCommand}" HeightRequest="64" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
