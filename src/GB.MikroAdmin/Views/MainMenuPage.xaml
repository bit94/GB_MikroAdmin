<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GB.MikroAdmin.ViewModels"
             x:Class="GB.MikroAdmin.Views.MainMenuPage"
             x:DataType="vm:MainMenuViewModel"
             Title="Inicio">
  <ScrollView>
    <VerticalStackLayout Padding="16" Spacing="10">
      <Label Text="Mikro Admin" FontAttributes="Bold" FontSize="28" />
      <Label Text="Administración de tickets de internet por tiempo." Style="{StaticResource Caption}" />

      <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource SurfaceAlt}">
        <Grid ColumnDefinitions="*,Auto">
          <VerticalStackLayout Spacing="1">
            <Label Text="Conectado a" Style="{StaticResource Caption}" />
            <Label Text="{Binding Connection.Display}" FontAttributes="Bold" />
          </VerticalStackLayout>
          <Button Grid.Column="1" Text="Desconectar" Command="{Binding DisconnectCommand}" Padding="12,6" />
        </Grid>
      </Border>

      <Label Text="Operación diaria" Style="{StaticResource SectionTitle}" />
      <Button Text="Tickets activos" Command="{Binding GoToUsersCommand}" HeightRequest="58" />
      <Button Text="Generar tickets" Command="{Binding GoToGenerateCommand}" HeightRequest="58" />
      <Button Text="Histórico de lotes" Command="{Binding GoToHistoryCommand}" HeightRequest="58" />

      <Label Text="Configuración del router" Style="{StaticResource SectionTitle}" />
      <Button Text="Perfiles y ancho de banda" Command="{Binding GoToProfilesCommand}" HeightRequest="58" />
      <Button Text="Interfaces" Command="{Binding GoToInterfacesCommand}" HeightRequest="58" />

      <Label Text="Ayuda" Style="{StaticResource SectionTitle}" />
      <Border Style="{StaticResource Card}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <VerticalStackLayout Spacing="1" VerticalOptions="Center">
            <Label Text="Guía de instalación" Style="{StaticResource CardTitle}" />
            <Label Text="Starlink, router, access points, hotspot, certificado, tickets y cliente final."
                   Style="{StaticResource Caption}" />
          </VerticalStackLayout>
          <Button Grid.Column="1" Text="Abrir" Style="{StaticResource SecondaryButton}"
                  HeightRequest="38" MinimumWidthRequest="84" Padding="14,0" FontSize="13"
                  Command="{Binding GoToGuideCommand}" VerticalOptions="Center" />
        </Grid>
      </Border>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
