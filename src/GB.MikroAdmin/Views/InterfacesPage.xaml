<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GB.MikroAdmin.Views"
             x:Class="GB.MikroAdmin.Views.InterfacesPage"
             Title="Interfaces">

  <ContentPage.Resources>
    <views:NoticeColorConverter x:Key="NoticeColor" />
    <views:RunningColorConverter x:Key="RunningColor" />
  </ContentPage.Resources>

  <Grid RowDefinitions="Auto,Auto,*">
    <VerticalStackLayout Grid.Row="0" Padding="12" Spacing="10">
      <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource SurfaceAlt}">
        <VerticalStackLayout Spacing="1">
          <Label Text="Conectado a" Style="{StaticResource Caption}" />
          <Label Text="{Binding Connection.Display}" FontAttributes="Bold" />
        </VerticalStackLayout>
      </Border>

      <Grid ColumnDefinitions="*,Auto">
        <Label Text="{Binding Summary}" VerticalOptions="Center" />
        <Button Grid.Column="1" Text="Actualizar" Command="{Binding RefreshCommand}" Padding="14,6" />
      </Grid>

      <CollectionView ItemsSource="{Binding Notices}" HeightRequest="72">
        <CollectionView.ItemTemplate>
          <DataTemplate>
            <Label Text="{Binding Text}" FontSize="13"
                   TextColor="{Binding Severity, Converter={StaticResource NoticeColor}}" />
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
    </VerticalStackLayout>

    <CollectionView Grid.Row="2" ItemsSource="{Binding Interfaces}" Margin="12,0,12,12">
      <CollectionView.EmptyView>
        <Label Text="No hay interfaces." Style="{StaticResource Caption}" Margin="0,20" HorizontalOptions="Center" />
      </CollectionView.EmptyView>
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Margin="0,0,0,6">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <BoxView WidthRequest="4" CornerRadius="2"
                       Color="{Binding Running, Converter={StaticResource RunningColor}}" />
              <VerticalStackLayout Grid.Column="1" Spacing="1">
                <Label Text="{Binding Name}" FontAttributes="Bold" />
                <Label Text="{Binding Type}" Style="{StaticResource Caption}" />
              </VerticalStackLayout>
              <Label Grid.Column="2" Text="{Binding Running}" VerticalOptions="Center"
                     TextColor="{Binding Running, Converter={StaticResource RunningColor}}" />
            </Grid>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
  </Grid>
</ContentPage>
