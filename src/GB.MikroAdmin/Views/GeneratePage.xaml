<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GB.MikroAdmin.Views"
             xmlns:vm="clr-namespace:GB.MikroAdmin.ViewModels"
             xmlns:models="clr-namespace:GB.MikroAdmin.Core.Models;assembly=GB.MikroAdmin.Core"
             xmlns:services="clr-namespace:GB.MikroAdmin.Core.Services;assembly=GB.MikroAdmin.Core"
             x:Class="GB.MikroAdmin.Views.GeneratePage"
             x:DataType="vm:UsersViewModel"
             Title="Generar tickets">

  <ContentPage.Resources>
    <views:NoticeColorConverter x:Key="NoticeColor" />
  </ContentPage.Resources>

  <Grid>
    <ScrollView>
      <VerticalStackLayout Padding="16,12,16,24" Spacing="16">

        <VerticalStackLayout Spacing="2">
          <Label Text="Nuevo lote" Style="{StaticResource PageTitle}" />
          <Label Text="{Binding Connection.Display, StringFormat='Router {0}'}" Style="{StaticResource Caption}" />
        </VerticalStackLayout>

        <Border Style="{StaticResource Card}">
          <VerticalStackLayout Spacing="16">
            <Label Text="Cada ticket usa el mismo código como usuario y contraseña."
                   Style="{StaticResource Caption}" />

            <VerticalStackLayout Spacing="6">
              <Label Text="Perfil" Style="{StaticResource FieldLabel}" />
              <Border Style="{StaticResource InputBorder}">
                <Picker Title="Elegir perfil" ItemsSource="{Binding Profiles}"
                        ItemDisplayBinding="{Binding Name, x:DataType=models:HotspotProfile}"
                        SelectedItem="{Binding SelectedProfile}" BackgroundColor="Transparent" />
              </Border>
              <Label Text="{Binding SelectedProfileDurationText}" Style="{StaticResource Caption}" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="110,*" ColumnSpacing="12">
              <VerticalStackLayout Spacing="6">
                <Label Text="Cantidad" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBorder}">
                  <Entry Placeholder="1 a 100" Keyboard="Numeric" Text="{Binding BatchQuantity}"
                         BackgroundColor="Transparent" />
                </Border>
              </VerticalStackLayout>
              <Button Grid.Column="1" Text="{Binding GenerateButtonText}" Style="{StaticResource PrimaryButton}"
                      Command="{Binding OpenBatchDialogCommand}"
                      IsEnabled="{Binding IsGenerating, Converter={StaticResource Invert}}"
                      VerticalOptions="End" />
            </Grid>

            <!-- Progreso y cancelación: un lote de 100 tarda minutos y antes no había forma de pararlo. -->
            <VerticalStackLayout IsVisible="{Binding IsGenerating}" Spacing="6">
              <ProgressBar Progress="{Binding ProgressPercent}" ProgressColor="{StaticResource Primary}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="{Binding ProgressText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Cancelar lote" Style="{StaticResource DangerTextButton}"
                        Command="{Binding CancelBatchCommand}" />
              </Grid>
            </VerticalStackLayout>
          </VerticalStackLayout>
        </Border>

        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Notices}" Spacing="2">
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="vm:Notice">
              <Label Text="{Binding Text}" FontSize="13"
                     TextColor="{Binding Severity, Converter={StaticResource NoticeColor}}" />
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
              <Label Text="Códigos generados" Style="{StaticResource SectionTitle}" Margin="0" />
              <Label Text="{Binding GeneratedCountText}" Style="{StaticResource Caption}"
                     IsVisible="{Binding CanExport}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Limpiar" Style="{StaticResource GhostButton}"
                    Command="{Binding ClearGeneratedCommand}" IsEnabled="{Binding CanExport}"
                    VerticalOptions="Center" />
          </Grid>

          <!-- Las acciones de entrega van antes de la lista para no quedar bajo cientos de códigos. -->
          <VerticalStackLayout Spacing="8" IsVisible="{Binding CanExport}">
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
              <Button Text="Imprimir" Style="{StaticResource PrimaryButton}" HeightRequest="44"
                      Command="{Binding PrintCommand}" IsEnabled="{Binding CanExport}"
                      Padding="8,0" FontSize="13" />
              <Button Grid.Column="1" Text="PDF" Style="{StaticResource SecondaryButton}"
                      Command="{Binding ShareCommand}" IsEnabled="{Binding CanExport}"
                      Padding="8,0" FontSize="13" />
              <Button Grid.Column="2" Text="CSV" Style="{StaticResource SecondaryButton}"
                      Command="{Binding ExportCsvCommand}" IsEnabled="{Binding CanExport}"
                      Padding="8,0" FontSize="13" />
              <Button Grid.Column="3" Text="HTML" Style="{StaticResource SecondaryButton}"
                      Command="{Binding ShareHtmlCommand}" IsEnabled="{Binding CanExport}"
                      Padding="8,0" FontSize="13" />
            </Grid>
            <Label Text="Imprimir genera tarjetas con QR, 30 por hoja carta. CSV para Excel; PDF y HTML para compartir."
                   Style="{StaticResource Caption}" />
          </VerticalStackLayout>

          <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Start"
                      BindableLayout.ItemsSource="{Binding Generated}">
            <BindableLayout.EmptyView>
              <Label Text="Los códigos aparecerán aquí después de generar el lote."
                     Style="{StaticResource Caption}" Margin="0,16" HorizontalOptions="Center" />
            </BindableLayout.EmptyView>
            <BindableLayout.ItemTemplate>
              <DataTemplate x:DataType="services:CreatedHotspotUser">
                <Border Style="{StaticResource Card}" Padding="10,8" Margin="2"
                        FlexLayout.Basis="48%" FlexLayout.Grow="1">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <Label Text="{Binding Name}" Style="{StaticResource Mono}" FontSize="15"
                           LineBreakMode="TailTruncation" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Copiar" Style="{StaticResource GhostButton}"
                            HeightRequest="30" MinimumHeightRequest="30" Padding="8,0" FontSize="12"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UsersViewModel}}, Path=CopyGeneratedCommand, x:DataType=vm:UsersViewModel}"
                            CommandParameter="{Binding .}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </FlexLayout>
        </VerticalStackLayout>
      </VerticalStackLayout>
    </ScrollView>

    <!-- Red y precio son obligatorios: se piden justo antes de crear el lote. -->
    <Grid IsVisible="{Binding IsBatchDialogVisible}" BackgroundColor="{StaticResource Scrim}" Padding="16">
      <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}" StrokeThickness="1"
              StrokeShape="RoundRectangle 16" Padding="20" MaximumWidthRequest="480"
              HorizontalOptions="Center" VerticalOptions="Center">
        <VerticalStackLayout Spacing="16">
          <VerticalStackLayout Spacing="2">
            <Label Text="Datos del ticket" Style="{StaticResource FormTitle}" />
            <Label Text="{Binding SelectedProfileDurationText}" Style="{StaticResource Caption}" />
          </VerticalStackLayout>

          <VerticalStackLayout Spacing="6">
            <Label Text="Red Wi-Fi" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputBorder}">
              <Entry Placeholder="Ej. GB_nextGen_PA01" Text="{Binding TicketSsid}"
                     BackgroundColor="Transparent" />
            </Border>
          </VerticalStackLayout>

          <VerticalStackLayout Spacing="6">
            <Label Text="Precio" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputBorder}">
              <Entry Placeholder="Ej. 15.00" Keyboard="Numeric" Text="{Binding TicketPrice}"
                     BackgroundColor="Transparent" />
            </Border>
          </VerticalStackLayout>

          <VerticalStackLayout BindableLayout.ItemsSource="{Binding Notices}" Spacing="2">
            <BindableLayout.ItemTemplate>
              <DataTemplate x:DataType="vm:Notice">
                <Label Text="{Binding Text}" FontSize="13"
                       TextColor="{Binding Severity, Converter={StaticResource NoticeColor}}" />
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </VerticalStackLayout>

          <BoxView HeightRequest="1" Color="{StaticResource Border}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Button Text="Generar lote" Style="{StaticResource PrimaryButton}"
                    Command="{Binding CreateBatchCommand}" />
            <Button Grid.Column="1" Text="Cancelar" Style="{StaticResource SecondaryButton}"
                    MinimumWidthRequest="104" Command="{Binding CancelBatchDialogCommand}" />
          </Grid>
        </VerticalStackLayout>
      </Border>
    </Grid>
  </Grid>
</ContentPage>
