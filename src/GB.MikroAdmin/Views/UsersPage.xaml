<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GB.MikroAdmin.Views"
             xmlns:vm="clr-namespace:GB.MikroAdmin.ViewModels"
             xmlns:models="clr-namespace:GB.MikroAdmin.Core.Models;assembly=GB.MikroAdmin.Core"
             x:Class="GB.MikroAdmin.Views.UsersPage"
             x:DataType="vm:UsersViewModel"
             Title="Tickets">

  <ContentPage.Resources>
    <views:TicketStateTextConverter x:Key="StateText" />
    <views:TicketStateColorConverter x:Key="StateColor" />
    <views:RemainingTextConverter x:Key="Remaining" />
    <views:NoticeColorConverter x:Key="NoticeColor" />
  </ContentPage.Resources>

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- Barra de conexión: en uso diario el dato más importante es a qué router estás pegado. -->
    <Border Grid.Row="0" Style="{StaticResource Card}" BackgroundColor="{StaticResource SurfaceAlt}" Margin="12,12,12,0">
      <Grid ColumnDefinitions="*,Auto">
        <VerticalStackLayout Spacing="1">
          <Label Text="Conectado a" Style="{StaticResource Caption}" />
          <Label Text="{Binding Connection.Display}" FontAttributes="Bold" />
        </VerticalStackLayout>
        <Button Grid.Column="1" Text="Actualizar" Command="{Binding RefreshCommand}" Padding="14,6" />
      </Grid>
    </Border>

    <VerticalStackLayout Grid.Row="1" Padding="12,10,12,0" Spacing="8">
      <Label Text="{Binding Summary}" Style="{StaticResource Caption}" />

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <Entry Placeholder="Buscar por código o perfil" Text="{Binding Filter}" />
        <HorizontalStackLayout Grid.Column="1" Spacing="4">
          <CheckBox IsChecked="{Binding OnlyExpired}" Color="{StaticResource StateExpired}" />
          <Label Text="Solo agotados" VerticalOptions="Center" Style="{StaticResource Caption}" />
        </HorizontalStackLayout>
      </Grid>

      <HorizontalStackLayout Spacing="8">
        <Button Text="Eliminar seleccionado" Command="{Binding DeleteSelectedCommand}"
                IsEnabled="{Binding HasSelectedUser}" Style="{StaticResource DangerButton}" Padding="12,6" />
        <Button Text="Limpiar agotados" Command="{Binding RemoveExpiredCommand}" Padding="12,6" />
      </HorizontalStackLayout>

      <!-- Avisos con severidad; se conservan los últimos para poder releer un error. -->
      <VerticalStackLayout BindableLayout.ItemsSource="{Binding Notices}">
        <BindableLayout.ItemTemplate>
          <DataTemplate x:DataType="vm:Notice">
            <Label Text="{Binding Text}" FontSize="13"
                   TextColor="{Binding Severity, Converter={StaticResource NoticeColor}}"
                   Margin="0,0,0,2" />
          </DataTemplate>
        </BindableLayout.ItemTemplate>
      </VerticalStackLayout>
    </VerticalStackLayout>

    <!-- Lista de tickets: código, perfil, tiempo restante y acción directa por fila. -->
    <CollectionView Grid.Row="2" ItemsSource="{Binding FilteredUsers}" Margin="12,4,12,12"
                    SelectionMode="Single" SelectedItem="{Binding SelectedUser}">
      <CollectionView.EmptyView>
        <Label Text="No hay tickets que coincidan." Style="{StaticResource Caption}" HorizontalOptions="Center" Margin="0,30" />
      </CollectionView.EmptyView>
      <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="models:HotspotUser">
          <Border Style="{StaticResource Card}" Margin="0,0,0,6">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
              <BoxView WidthRequest="4" CornerRadius="2"
                       Color="{Binding State, Converter={StaticResource StateColor}}" />
              <VerticalStackLayout Grid.Column="1" Spacing="1">
                <Label Text="{Binding Name}" Style="{StaticResource Mono}" />
                <Label Text="{Binding Profile}" Style="{StaticResource Caption}" />
              </VerticalStackLayout>
              <VerticalStackLayout Grid.Column="2" Spacing="1" HorizontalOptions="End">
                <Label Text="{Binding Remaining, Converter={StaticResource Remaining}}"
                       TextColor="{Binding State, Converter={StaticResource StateColor}}"
                       FontAttributes="Bold" HorizontalOptions="End" />
                <Label Text="{Binding State, Converter={StaticResource StateText}}"
                       Style="{StaticResource Caption}" HorizontalOptions="End" />
              </VerticalStackLayout>
              <Button Grid.Column="3" Text="Borrar" Padding="10,4" FontSize="13"
                      Style="{StaticResource DangerButton}"
                      Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UsersViewModel}}, Path=DeleteUserCommand, x:DataType=vm:UsersViewModel}"
                      CommandParameter="{Binding .}" />
            </Grid>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
  </Grid>
</ContentPage>
