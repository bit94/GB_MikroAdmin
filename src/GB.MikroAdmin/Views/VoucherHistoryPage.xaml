<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GB.MikroAdmin.Views"
             x:Class="GB.MikroAdmin.Views.VoucherHistoryPage"
             Title="Histórico">

  <ContentPage.Resources>
    <views:NoticeColorConverter x:Key="NoticeColor" />
  </ContentPage.Resources>

  <Grid RowDefinitions="Auto,Auto,*">
    <VerticalStackLayout Grid.Row="0" Padding="12" Spacing="8">
      <Label Text="Lotes generados" Style="{StaticResource SectionTitle}" />
      <Label Text="Cada lote conserva sus códigos aunque cierres la aplicación, para poder reimprimirlos o consultarlos."
             Style="{StaticResource Caption}" />
      <Button Text="Actualizar" Command="{Binding RefreshCommand}" Padding="14,6" HorizontalOptions="Start" />
    </VerticalStackLayout>

    <CollectionView Grid.Row="1" ItemsSource="{Binding Notices}" HeightRequest="40" Margin="12,0">
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Label Text="{Binding Text}" FontSize="13"
                 TextColor="{Binding Severity, Converter={StaticResource NoticeColor}}" />
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>

    <CollectionView Grid.Row="2" ItemsSource="{Binding Batches}" Margin="12,4,12,12">
      <CollectionView.EmptyView>
        <Label Text="Todavía no hay lotes guardados." Style="{StaticResource Caption}" Margin="0,30" HorizontalOptions="Center" />
      </CollectionView.EmptyView>
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Margin="0,0,0,6">
            <VerticalStackLayout Spacing="4">
              <Label Text="{Binding Title}" FontAttributes="Bold" />
              <Label Text="{Binding Codes}" Style="{StaticResource Mono}" FontSize="13" />
            </VerticalStackLayout>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
  </Grid>
</ContentPage>
