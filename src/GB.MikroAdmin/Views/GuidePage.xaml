<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GB.MikroAdmin.ViewModels"
             x:Class="GB.MikroAdmin.Views.GuidePage"
             x:DataType="vm:GuideViewModel"
             Shell.TabBarIsVisible="False"
             Title="Guía">

  <Grid>
    <ScrollView>
      <VerticalStackLayout Padding="16,12,16,32" Spacing="12">

        <VerticalStackLayout Spacing="4">
          <Label Text="Guía de instalación" Style="{StaticResource PageTitle}" />
          <Label Text="{Binding Subtitle}" FontSize="14" TextColor="{StaticResource TextSecondary}" />
          <Label Text="{Binding Stats}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
        </VerticalStackLayout>

        <Border BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource StateExpired}" StrokeThickness="1"
                StrokeShape="RoundRectangle 12" Padding="14">
          <VerticalStackLayout Spacing="6">
            <Label Text="Antes de reiniciar" Style="{StaticResource CardTitle}" FontSize="17" />
            <Label Text="{Binding Warning}" FontSize="15" LineHeight="1.35"
                   TextColor="{StaticResource StateExpired}" />
          </VerticalStackLayout>
        </Border>

        <Border Style="{StaticResource Card}" Padding="14">
          <VerticalStackLayout Spacing="6">
            <Label Text="Cómo usar la guía" Style="{StaticResource CardTitle}" FontSize="17" />
            <Label Text="{Binding Intro}" FontSize="15" LineHeight="1.35" />
          </VerticalStackLayout>
        </Border>

        <Border Style="{StaticResource Card}" Padding="14">
          <VerticalStackLayout Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <Label Text="Tu progreso" FontSize="15" FontAttributes="Bold" />
              <Label Grid.Column="1" Text="{Binding ProgressText}" FontSize="14"
                     TextColor="{StaticResource StateAvailable}" VerticalOptions="Center" />
            </Grid>
            <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource StateAvailable}"
                         BackgroundColor="{StaticResource Border}" HeightRequest="6" />
            <Label Text="{Binding ProgressHint}" FontSize="13" LineHeight="1.3"
                   TextColor="{StaticResource TextSecondary}" />
            <Button Text="Reiniciar avance" Style="{StaticResource GhostButton}"
                    FontSize="13" HeightRequest="32" MinimumHeightRequest="32" Padding="12,0"
                    HorizontalOptions="End" IsVisible="{Binding HasProgress}"
                    Command="{Binding ResetProgressCommand}" />
          </VerticalStackLayout>
        </Border>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
          <Button Text="Expandir todo" Style="{StaticResource SecondaryButton}"
                  HeightRequest="44" FontSize="14" Padding="8,0"
                  Command="{Binding ExpandAllCommand}" />
          <Button Grid.Column="1" Text="Contraer todo" Style="{StaticResource SecondaryButton}"
                  HeightRequest="44" FontSize="14" Padding="8,0"
                  Command="{Binding CollapseAllCommand}" />
        </Grid>

        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Chapters}" Spacing="12">
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="vm:GuideChapter">
              <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout Spacing="0">

                  <!-- El encabezado entero pliega el capítulo; el contenido de abajo no. -->
                  <Grid Padding="16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border BackgroundColor="{StaticResource Primary}" Stroke="Transparent"
                            StrokeShape="RoundRectangle 8" Padding="0"
                            WidthRequest="38" HeightRequest="34" VerticalOptions="Start">
                      <Label Text="{Binding Number}" TextColor="White" FontSize="14"
                             FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                      <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" FontSize="18" />
                      <Label Text="{Binding Summary}" FontSize="14" LineHeight="1.3"
                             TextColor="{StaticResource TextSecondary}" />
                      <Label Text="{Binding ProgressText}" FontSize="13">
                        <Label.Triggers>
                          <DataTrigger TargetType="Label" Binding="{Binding IsComplete}" Value="True">
                            <Setter Property="TextColor" Value="{StaticResource StateAvailable}" />
                          </DataTrigger>
                        </Label.Triggers>
                      </Label>
                      <ProgressBar Progress="{Binding Progress}"
                                   ProgressColor="{StaticResource StateAvailable}"
                                   BackgroundColor="{StaticResource Border}"
                                   HeightRequest="4" Margin="0,2,0,0" />
                    </VerticalStackLayout>

                    <Label Grid.Column="2" Text="{Binding ToggleGlyph}" FontSize="22"
                           TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />

                    <Grid.GestureRecognizers>
                      <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                    </Grid.GestureRecognizers>
                  </Grid>

                  <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                                       Padding="16,0,16,16" Spacing="10"
                                       BindableLayout.ItemsSource="{Binding VisibleSteps}">
                    <BindableLayout.ItemTemplate>
                      <DataTemplate x:DataType="vm:GuideStep">
                        <Border BackgroundColor="{StaticResource SurfaceAlt}" Stroke="Transparent"
                                StrokeShape="RoundRectangle 10" Padding="14">
                          <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                              <!-- Botón real (no un gesto): funciona con teclado, lector de pantalla y toque. -->
                              <Grid WidthRequest="38" HeightRequest="38" VerticalOptions="Start">
                                <Button IsVisible="{Binding IsNotDone}" Text=""
                                        WidthRequest="38" HeightRequest="38" MinimumHeightRequest="38"
                                        CornerRadius="19" Padding="0" FontSize="19"
                                        BackgroundColor="Transparent"
                                        BorderColor="{StaticResource Border}" BorderWidth="1.5"
                                        SemanticProperties.Description="{Binding CheckDescription}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GuideViewModel}}, Path=ToggleStepCommand, x:DataType=vm:GuideViewModel}"
                                        CommandParameter="{Binding .}" />
                                <Button IsVisible="{Binding IsDone}" Text="✓"
                                        WidthRequest="38" HeightRequest="38" MinimumHeightRequest="38"
                                        CornerRadius="19" Padding="0" FontSize="19" FontAttributes="Bold"
                                        BackgroundColor="{StaticResource StateAvailable}"
                                        BorderColor="{StaticResource StateAvailable}" BorderWidth="0"
                                        TextColor="White"
                                        SemanticProperties.Description="{Binding CheckDescription}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GuideViewModel}}, Path=ToggleStepCommand, x:DataType=vm:GuideViewModel}"
                                        CommandParameter="{Binding .}" />
                              </Grid>

                              <Label Grid.Column="1" Text="{Binding Number}" FontSize="13"
                                     FontAttributes="Bold" TextColor="{StaticResource TextSecondary}"
                                     VerticalOptions="Center" />
                              <Label Grid.Column="2" Text="{Binding Title}" FontSize="16"
                                     FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>

                            <Label Text="{Binding Body}" FontSize="15" LineHeight="1.4" />

                            <Border IsVisible="{Binding HasCode}" BackgroundColor="#0B1626"
                                    Stroke="{StaticResource Border}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="12">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Text="{Binding Code}" Style="{StaticResource Mono}"
                                       FontSize="13" LineHeight="1.35" LineBreakMode="CharacterWrap" />
                                <Button Grid.Column="1" Text="Copiar" Style="{StaticResource GhostButton}"
                                        HeightRequest="32" MinimumHeightRequest="32" Padding="9,0"
                                        FontSize="13" VerticalOptions="Start"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GuideViewModel}}, Path=CopyCommand, x:DataType=vm:GuideViewModel}"
                                        CommandParameter="{Binding Code}" />
                              </Grid>
                            </Border>

                            <Border IsVisible="{Binding HasExample}" BackgroundColor="{StaticResource Surface}"
                                    Stroke="{StaticResource Border}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="12">
                              <VerticalStackLayout Spacing="4">
                                <Label Text="EJEMPLO" FontSize="11" FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding Example}" FontSize="14" LineHeight="1.35" />
                              </VerticalStackLayout>
                            </Border>

                            <Label IsVisible="{Binding IsTip}" Text="{Binding Note}" FontSize="14"
                                   LineHeight="1.35" TextColor="{StaticResource StateAvailable}" />
                            <Label IsVisible="{Binding IsWarning}" Text="{Binding Note}" FontSize="14"
                                   LineHeight="1.35" TextColor="{StaticResource StateExpired}" />
                          </VerticalStackLayout>
                        </Border>
                      </DataTemplate>
                    </BindableLayout.ItemTemplate>
                  </VerticalStackLayout>

                </VerticalStackLayout>
              </Border>
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <Label Text="Al terminar, guarda un respaldo del router y del histórico, y anota la fecha de vencimiento del certificado."
               FontSize="13" TextColor="{StaticResource TextSecondary}"
               HorizontalTextAlignment="Center" Margin="12,8,12,0" />
      </VerticalStackLayout>
    </ScrollView>

    <!-- Aviso flotante: el botón Copiar puede quedar lejos del inicio de la página. -->
    <Border IsVisible="{Binding ShowCopied}" BackgroundColor="{StaticResource SurfaceAlt}"
            Stroke="{StaticResource Border}" StrokeThickness="1" StrokeShape="RoundRectangle 20"
            Padding="16,8" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,24">
      <Label Text="Copiado al portapapeles" FontSize="14" />
    </Border>
  </Grid>
</ContentPage>
